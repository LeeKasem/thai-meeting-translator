# Copy this file to .env and fill in your Azure Speech resource values.
# Azure portal > your Speech resource > "Keys and Endpoint".
AZURE_SPEECH_KEY=
# Short region name, e.g. southeastasia, eastus, westeurope
AZURE_SPEECH_REGION=

# Optional: voice used when translating INTO each language (defaults shown).
# TTS_VOICE_EN=en-US-JennyNeural
# TTS_VOICE_TH=th-TH-NiwatNeural

# Optional: end-of-speech silence in ms before Azure finalizes a sentence
# (100-5000; unset = service default). Shorter = earlier translations, but
# sentences with pauses get split. See README section 8.
# SEGMENTATION_SILENCE_MS=500
